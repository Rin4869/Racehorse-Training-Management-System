# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/racehorse?schema=public

# JWT — generate long random strings for real use
JWT_ACCESS_SECRET=dev-access-secret-change-me-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please
JWT_REFRESH_TTL=7d

# Frontend base URL (used to build links in emails)
APP_WEB_URL=http://localhost:5173

# SMTP (Gmail + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Racehorse Club <your-gmail@gmail.com>"

# File uploads
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
